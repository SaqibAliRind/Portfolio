# ============================================================
# .gitignore — Full Stack MERN Portfolio
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
backend/node_modules/

# ── Environment Variables (NEVER commit these) ────────────────
.env
.env.local
.env.production
.env.development
backend/.env

# ── Build Outputs ────────────────────────────────────────────
dist/
build/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS Files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Misc ─────────────────────────────────────────────────────
.eslintcache
